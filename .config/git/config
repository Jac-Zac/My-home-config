# Machine-specific identity and overrides stay out of the repository.
[include]
	path = local

[pull]
	rebase = true
[core]
	editor = nvim
	# Share the same Delta settings with LazyGit.
	pager = delta --config ~/.config/git/config
[interactive]
	diffFilter = delta --config ~/.config/git/config --color-only
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true

[push]
	# Set the upstream automatically on the first push of a new branch.
	autoSetupRemote = true
[fetch]
	# Remove stale remote-tracking branches when fetching.
	prune = true
[delta]
	# Nord syntax colors; diff colors are configured separately below.
	syntax-theme = Nord
	dark = true
	# Diff styles from Delta's arctic-fox preset; ANSI colors follow the terminal theme.
	# https://github.com/dandavison/delta/blob/main/themes.gitconfig
	minus-style = brightred
	minus-emph-style = black red
	plus-style = brightgreen
	plus-emph-style = black green
