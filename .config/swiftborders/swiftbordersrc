# SwiftBorders trial — mirrors JankyBorders look (bordersrc: style=round,
# width=4.0, active 0xFFA3BE8C, inactive 0xFF4C566A). No hidpi key: AppKit
# handles scaling. File is live-reloaded (no restart needed).
# Rollback: `brew services stop swiftborders; brew services start borders`.
# NOTE: radius=auto matches the OS outer radius (~26pt on Tahoe) which looks
# much rounder than JankyBorders' tight hug — hence the explicit small radius.
# Width 3.0 compensates: SwiftBorders draws the ring fully outside the frame,
# so equal pt values read thicker than JankyBorders.
active_color=0xFFA3BE8C
inactive_color=0xFF4C566A
width=3.0
style=round
radius=12
order=above
