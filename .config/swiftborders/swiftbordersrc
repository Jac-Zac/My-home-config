# SwiftBorders: active-window borders. Live-reloaded (no restart needed);
# AppKit handles hidpi scaling.
# radius=auto would match the OS window radius (~26pt on Tahoe) and look too
# round, hence the explicit 14. The ring is drawn fully outside the frame,
# so a thin width already reads bold.
active_color=0xFFA3BE8C
inactive_color=0xFF4C566A
width=2.5
radius=14
order=above
launchAtLogin
