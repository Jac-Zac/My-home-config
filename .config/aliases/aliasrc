cat_all() {
  local recursive=0
  # Check if the first argument is -r
  if [ "$1" = "-r" ]; then
    recursive=1
    shift
  fi

  if [ $recursive -eq 1 ]; then
    # Recursive: find all files in current directory and subdirectories
    find . -type f | while IFS= read -r f; do
      echo "Filename: $f"
      cat "$f"
      echo
    done
  else
    # Non-recursive: only files in current directory
    for f in *; do
      if [ -f "$f" ]; then
        echo "Filename: $f"
        cat "$f"
        echo
      fi
    done
  fi
}

