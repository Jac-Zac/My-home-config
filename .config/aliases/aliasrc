# Aliases
gopen() {
  local url
  url=$(git remote get-url origin 2>/dev/null || git remote get-url thlm 2>/dev/null)
  url="${url#git@github.com:}"
  url="${url#https://github.com/}"
  url="${url%.git}"
  open "https://github.com/$url"
}

# Useful browser commands
# ask Perplexity something ...
_ask() {
  if [ -z "$*" ]; then
    open "https://www.perplexity.ai/"
    return
  fi

  open "https://www.perplexity.ai/search?q=$(jq -nr --arg q "$*" '$q | @uri')"
}

